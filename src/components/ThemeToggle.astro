---
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Switch color theme"
  class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface/60 text-muted transition-colors hover:border-primary hover:text-primary"
>
  <svg class="hidden size-[18px] dark-only" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="size-[18px] light-only" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style is:global>
  /* dark theme shows the sun (switch to light); light theme shows the moon */
  :root:not([data-theme='light']) #theme-toggle .dark-only { display: block; }
  :root:not([data-theme='light']) #theme-toggle .light-only { display: none; }
  :root[data-theme='light'] #theme-toggle .dark-only { display: none; }
  :root[data-theme='light'] #theme-toggle .light-only { display: block; }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    btn?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('vanguard-theme', next);
    } catch {}
    sync();
  });
</script>
