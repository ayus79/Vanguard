---
import { pad, type Layer } from '../data/layers';
import { url } from '../lib/url';
interface Props {
  layer: Layer;
}
const { layer } = Astro.props;
---

<article class="group relative grid gap-x-8 gap-y-3 px-5 py-7 transition-colors hover:bg-surface focus-within:bg-surface sm:px-7 md:grid-cols-[3.5rem_1fr_1.1fr] md:items-baseline">
  <p class="font-display text-3xl font-semibold text-secondary-fg" aria-label={`Layer ${layer.n}`}>{pad(layer.n)}</p>
  <div>
    <h3 class="text-xl font-semibold">{layer.name}</h3>
    <p class="mt-1 text-sm text-muted">{layer.features.join(' · ')}</p>
  </div>
  <div>
    <p class="text-muted">{layer.description}</p>
    <a
      href={url(layer.doc)}
      class="mt-3 inline-block text-sm font-medium text-primary underline-offset-4 after:absolute after:inset-0 after:content-[''] hover:text-primary-hover hover:underline"
    >
      Read the docs<span class="sr-only"> for {layer.name}</span> →
    </a>
  </div>
</article>
