---
const layers = ['Edge guard', 'Traffic control', 'Authentication', 'Authorization', 'Request validation', 'Proxy + resilience'];
const services = ['users-api', 'payments-api', 'orders-api'];
---

<figure>
  <!-- Wide layout -->
  <svg viewBox="0 0 960 350" role="img" aria-labelledby="arch-t arch-d" class="arch hidden h-auto w-full md:block">
    <title id="arch-t">Vanguard architecture</title>
    <desc id="arch-d">
      Clients send requests to Vanguard. Inside Vanguard they pass six layers in order. Only requests
      that pass every layer are proxied to your backend services.
    </desc>
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="arrow-head"></path>
      </marker>
    </defs>

    <rect x="20" y="125" width="150" height="100" rx="10" class="node" />
    <text x="95" y="167" text-anchor="middle" class="t-title">Clients</text>
    <text x="95" y="188" text-anchor="middle" class="t-sub">web · mobile · partners</text>

    <line x1="172" y1="175" x2="246" y2="175" class="arrow" marker-end="url(#arr)" />

    <rect x="250" y="20" width="460" height="310" rx="14" class="shield" />
    <text x="274" y="46" class="t-eyebrow">Vanguard gateway</text>
    {layers.map((l, i) => (
      <g>
        <rect x="274" y={62 + i * 44} width="412" height="34" rx="7" class="layer" />
        <text x="290" y={84 + i * 44} class="t-eyebrow t-n">0{i + 1}</text>
        <text x="338" y={84 + i * 44} class="t-layer">{l}</text>
      </g>
    ))}

    <line x1="712" y1="175" x2="786" y2="175" class="arrow ok" marker-end="url(#arr)" />
    <text x="749" y="160" text-anchor="middle" class="t-ok">Allowed</text>

    {services.map((s, i) => (
      <g>
        <rect x="790" y={50 + i * 100} width="150" height="70" rx="10" class="svc" />
        <text x="865" y={90 + i * 100} text-anchor="middle" class="t-title t-mono">{s}</text>
      </g>
    ))}

    <text x="480" y="346" text-anchor="middle" class="t-bad">Blocked requests never reach your services.</text>
  </svg>

  <!-- Narrow layout -->
  <svg viewBox="0 0 340 660" role="img" aria-labelledby="archm-t" class="arch h-auto w-full md:hidden">
    <title id="archm-t">Vanguard architecture: clients, six layers, then services</title>
    <rect x="70" y="10" width="200" height="56" rx="10" class="node" />
    <text x="170" y="43" text-anchor="middle" class="t-title">Clients</text>
    <line x1="170" y1="68" x2="170" y2="96" class="arrow" marker-end="url(#arr)" />

    <rect x="10" y="100" width="320" height="330" rx="14" class="shield" />
    <text x="28" y="126" class="t-eyebrow">Vanguard gateway</text>
    {layers.map((l, i) => (
      <g>
        <rect x="26" y={142 + i * 44} width="288" height="34" rx="7" class="layer" />
        <text x="40" y={164 + i * 44} class="t-eyebrow t-n">0{i + 1}</text>
        <text x="84" y={164 + i * 44} class="t-layer">{l}</text>
      </g>
    ))}

    <line x1="170" y1="432" x2="170" y2="470" class="arrow ok" marker-end="url(#arr)" />
    <text x="182" y="456" class="t-ok">Allowed</text>

    {services.map((s, i) => (
      <g>
        <rect x={10 + i * 110} y="476" width="100" height="56" rx="10" class="svc" />
        <text x={60 + i * 110} y="509" text-anchor="middle" class="t-sub t-mono">{s}</text>
      </g>
    ))}
    <text x="170" y="570" text-anchor="middle" class="t-bad">Blocked requests never</text>
    <text x="170" y="588" text-anchor="middle" class="t-bad">reach your services.</text>
  </svg>
</figure>

<style>
  .node { fill: var(--c-surface); stroke: var(--c-line); }
  .shield { fill: var(--c-surface); stroke: var(--c-primary); stroke-opacity: 0.8; }
  .layer { fill: var(--c-raised); stroke: var(--c-line); }
  .svc { fill: var(--c-surface); stroke: var(--c-success); stroke-opacity: 0.6; }
  .arrow { stroke: var(--c-primary); stroke-width: 1.5; fill: none; }
  .arrow.ok { stroke: var(--c-success); }
  .arrow-head { fill: context-stroke; }
  .t-title { font: 600 17px var(--font-display); fill: var(--c-fg); }
  .t-mono { font-family: var(--font-mono); font-size: 13px; font-weight: 500; }
  .t-sub { font: 12px var(--font-sans); fill: var(--c-muted); }
  .t-sub.t-mono { font-family: var(--font-mono); font-size: 10px; fill: var(--c-fg); }
  .t-layer { font: 500 13px var(--font-sans); fill: var(--c-fg); }
  .t-eyebrow { font: 600 13px var(--font-sans); fill: var(--c-primary); }
  .t-n { fill: var(--c-muted); }
  .t-ok { font: 600 12px var(--font-sans); fill: var(--c-success); }
  .t-bad { font: 500 13px var(--font-sans); fill: var(--c-danger); }
</style>
